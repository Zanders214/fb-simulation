{
  "expo": {
    "name": "fb-simulation",
    "slug": "fb-simulation",
    "version": "1.0.0",
    "scheme": "fbsim",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b6e4f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.denniszanders.fbsimulation"
    },
    "android": {
      "package": "com.denniszanders.fbsimulation",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b6e4f"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}

{
  "name": "fb-simulation",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8082",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "demo": "tsx scripts/demo.ts",
    "bench": "tsx scripts/bench.ts",
    "bench:gc": "node --expose-gc --import tsx scripts/bench.ts",
    "analyze": "EXPO_UNSTABLE_ATLAS=true expo export --platform web && expo-atlas .expo/atlas.jsonl",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-screen-orientation": "~9.0.9",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.3",
    "@types/react": "~19.1.0",
    "eslint-plugin-react-perf": "^3.3.3",
    "eslint-plugin-sonarjs": "^4.0.3",
    "expo-atlas": "^0.4.3",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.0",
    "tsx": "^4.22.4",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.{ts,tsx}",
      "**/*.test.{ts,tsx}"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "collectCoverageFrom": [
      "src/engine/**/*.{ts,tsx}",
      "!src/engine/**/__tests__/**"
    ],
    "coverageReporters": [
      "lcov",
      "text-summary"
    ]
  },
  "private": true
}
